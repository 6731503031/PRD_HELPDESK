{
  "name": "helpdesk-team14",
  "version": "1.0.0",
  "description": "Helpdesk Platform (Team 14) - Cloudflare Workers + Hono + D1, per PRD v1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build:web": "vite build --config frontend/vite.config.ts",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit -p backend && tsc --noEmit -p frontend",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:local:fresh": "wrangler d1 execute helpdesk-db --local --file=./database/schema.sql",
    "db:local:migrate": "wrangler d1 execute helpdesk-db --local --file=./database/migrations/0002_final_features.sql",
    "db:remote:migrate": "wrangler d1 execute helpdesk-db --remote --file=./database/migrations/0002_final_features.sql",
    "mock:maintenance": "node scripts/send-mock-maintenance-event.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240605.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.8",
    "wrangler": "^3.114.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.11"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
